# Docker Compose settings for the local stack.
#   cp .env.example .env
#
# Application settings live in webvu-api/.env and webvu-ui/.env.

POSTGRES_USER=webvu
POSTGRES_PASSWORD=webvu
POSTGRES_DB=webvu

MINIO_ROOT_USER=webvu
MINIO_ROOT_PASSWORD=webvu-local-secret
ASSETS_BUCKET=webvu-assets

# Where Caddy reaches the API and UI dev servers running on the host.
# Leave unset and use ./scripts/dev-up.sh, which detects it — on Docker
# Desktop + WSL2 the correct value is this distro's IP, which changes on
# restart, so hardcoding it here will eventually break.
# CADDY_UPSTREAM_HOST=

# Plain http by default. For the TLS tier (see SPEC.md § Local Development):
#   CADDY_SCHEME=https
#   CADDY_TLS_DIRECTIVE=tls internal
CADDY_SCHEME=http
CADDY_TLS_DIRECTIVE=
