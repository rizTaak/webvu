# Local UI configuration. Copy to .env.local — never commit the copy.

# Server-side calls from the SSR renderer to the API. Goes direct to the
# host port rather than through Caddy, so rendering does not depend on the
# proxy being up.
API_URL=http://localhost:3000

# Client-side calls from the browser, which must go through Caddy so the
# request carries a matching origin.
NEXT_PUBLIC_API_URL=http://api.webvu.localhost

# Base domain the middleware strips to resolve a slug from the Host header.
# beardbaker.webvu.localhost -> slug "beardbaker"
NEXT_PUBLIC_SITE_DOMAIN=webvu.localhost

NEXT_PUBLIC_CDN_URL=http://cdn.webvu.localhost

# Shared secret sent on POST /analytics/visit. Server-side only — must not
# be exposed to the browser, so it carries no NEXT_PUBLIC_ prefix.
ANALYTICS_INTERNAL_SECRET=local-dev-internal-secret
