# Local API configuration. Copy to .env — never commit the copy.
# Every value here is a local default; nothing in this file is a real secret.

NODE_ENV=development
PORT=3000

# --- Data -----------------------------------------------------------------
DATABASE_URL=postgresql://webvu:webvu@localhost:5432/webvu
REDIS_URL=redis://localhost:6379

# --- Public URLs ----------------------------------------------------------
# Used to build links in emails and OAuth redirects.
APP_URL=http://webvu.localhost
DASHBOARD_URL=http://dashboard.webvu.localhost
ADMIN_URL=http://admin.webvu.localhost
API_URL=http://api.webvu.localhost
CDN_URL=http://cdn.webvu.localhost
SITE_DOMAIN=webvu.localhost

# --- Drivers (SPEC.md § Local Development) --------------------------------
# Production values: google | resend | stripe | s3
AUTH_DRIVER=dev-stub
MAIL_DRIVER=smtp
BILLING_DRIVER=dev-stub
STORAGE_DRIVER=minio

# --- Dev auth stub --------------------------------------------------------
# Guard 2 of 3. Guard 1 is NODE_ENV, guard 3 is a startup assertion that
# refuses to boot if this is true while DATABASE_URL is not local.
DEV_AUTH_ENABLED=true

# --- Session --------------------------------------------------------------
# Secure is dropped on http; host-only, HttpOnly and SameSite are unchanged.
JWT_SECRET=local-dev-jwt-secret-not-used-anywhere-real
REFRESH_TOKEN_PEPPER=local-dev-refresh-pepper
COOKIE_SECURE=false

# --- Storage (MinIO) ------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=webvu-assets
S3_ACCESS_KEY_ID=webvu
S3_SECRET_ACCESS_KEY=webvu-local-secret
S3_FORCE_PATH_STYLE=true

# --- Mail (Mailpit) -------------------------------------------------------
# Web UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM="Webvu <no-reply@webvu.localhost>"

# --- Captcha --------------------------------------------------------------
# Lower difficulty locally so the widget does not add a second to every submit.
ALTCHA_HMAC_KEY=local-dev-altcha-key
ALTCHA_COMPLEXITY=10000

# --- Analytics ------------------------------------------------------------
# Shared secret the SSR renderer sends on POST /analytics/visit.
ANALYTICS_INTERNAL_SECRET=local-dev-internal-secret

# --- Billing --------------------------------------------------------------
TRIAL_DAYS=30
# Only read when BILLING_DRIVER=stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=

# --- Google OAuth ---------------------------------------------------------
# Only read when AUTH_DRIVER=google, which needs the TLS tier: Google will
# not register an http:// redirect URI for a host other than localhost.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
